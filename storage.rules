rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.enabled == true;
    }

    function isManagedImagePath(collectionName) {
      return collectionName in ['projects', 'experience', 'products', 'site_content'];
    }

    match /{collectionName}/{allPaths=**} {
      allow read: if isManagedImagePath(collectionName);
      allow write: if isAdmin()
        && isManagedImagePath(collectionName)
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
