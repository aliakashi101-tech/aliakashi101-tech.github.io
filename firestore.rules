rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.enabled == true;
    }

    function validAnalyticsEvent() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'kind', 'visitorId', 'sessionId', 'path', 'referrer', 'device',
          'language', 'country', 'city', 'targetType', 'targetId',
          'occurredAt', 'expiresAt'
        ])
        && data.keys().hasAll([
          'kind', 'visitorId', 'sessionId', 'path', 'referrer', 'device',
          'language', 'country', 'city', 'occurredAt', 'expiresAt'
        ])
        && data.kind in ['page_view', 'click']
        && data.visitorId is string && data.visitorId.size() <= 80
        && data.sessionId is string && data.sessionId.size() <= 80
        && data.path is string && data.path.size() <= 200
        && data.referrer is string && data.referrer.size() <= 128
        && data.device in ['mobile', 'tablet', 'desktop', 'unknown']
        && data.language in ['en', 'ar']
        && data.country is string && data.country.size() <= 128
        && data.city is string && data.city.size() <= 128
        && (!('targetType' in data) || data.targetType in ['section', 'contact', 'social', 'resume', 'project', 'product'])
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 120))
        && data.occurredAt is timestamp
        && data.occurredAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(91, 'd');
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.hidden == false;
      allow create, update, delete: if isAdmin();
    }

    match /experience/{entryId} {
      allow read: if isAdmin() || resource.data.get('hidden', false) != true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.get('hidden', false) != true;
      allow create, update, delete: if isAdmin();
    }

    match /site_content/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /cv_profiles/{profileId} {
      allow read, write: if isAdmin();
    }

    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if validAnalyticsEvent();
      allow update, delete: if false;
    }

    match /adminUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
  }
}
